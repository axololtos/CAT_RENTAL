DATA_SOURCE_TYPE=local
CLOUD_CSV_URL=
LOCAL_CSV_PATH=data/equipment_rentals.csv
REFRESH_INTERVAL_SECONDS=30
SQLITE_PATH=data/rentals.db
DEBUG=false

# Optional DynamoDB mirror (off by default). See aws/local/README.md.
USE_DYNAMODB=false
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT_URL=
DYNAMODB_CONTRACTS_TABLE=RentalContracts
DYNAMODB_STATE_TABLE=EquipmentLiveState
