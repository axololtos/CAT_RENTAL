# Copy to aws/.env and fill in real values. Never commit the populated file —
# .env is already covered by the repo-wide .gitignore pattern; double check
# before committing if you rename it.

AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

DYNAMODB_CONTRACTS_TABLE=RentalContracts
DYNAMODB_STATE_TABLE=EquipmentLiveState

# Filled in automatically by `cdk deploy` output, or copy it from the AWS
# Console (SNS > Topics > cat-rentals-alerts) after the stack is deployed.
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:cat-rentals-alerts

GITHUB_REPO_URL=https://github.com/axololtos/CAT_RENTAL.git

# Optional: email address to auto-subscribe to SNS alerts at deploy time.
ALERT_EMAIL=

# Only needed if you wire an AI assistant / chat feature into the frontend.
# Provide exactly one of these — never commit a real key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
